{
  "name": "discord-seen-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight seen/acknowledgement tracking for a small Discord team",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "node --watch --env-file=.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:migrate": "node --env-file=.env scripts/migrate.ts",
    "register-commands": "node --env-file=.env scripts/register-commands.ts",
    "forget-user": "node --env-file=.env scripts/forget-user.ts",
    "probe:reply-missing": "node --env-file=.env scripts/probe-reply-missing.ts",
    "probe:history": "node --env-file=.env scripts/probe-history.ts"
  },
  "dependencies": {
    "@discordjs/core": "^2.6.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.6",
    "p-limit": "^7.3.3",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
