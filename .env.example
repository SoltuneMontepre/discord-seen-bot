# Required
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Storage — the directory MUST be on host storage encrypted at rest (see README)
DATABASE_PATH=./data/seen.db

# trace | debug | info | warn | error
LOG_LEVEL=info
NODE_ENV=development

# M9 auto-tracking (both false = exactly the M0–M7 behaviour)
# Explicit @user mentions auto-create a status card. Needs no privileged intent.
MENTION_AUTO_TRACK_ENABLED=false
# Role sources: channel policies (and, together with MENTION_AUTO_TRACK_ENABLED, @role mentions).
# Requires "Server Members Intent" in the Developer Portal.
ROLE_TARGETS_ENABLED=false
# Maximum resolved auto-tracking targets (1..500). Startup fails outside that range.
AUTO_TRACK_MAX_TARGETS=100

# Dev-only (ignored when NODE_ENV=production): shorten policy windows for manual testing
# SEEN_WEAK_WINDOW_MINUTES=2
# SEEN_TRACKING_TTL_MINUTES=3
# SEEN_RETENTION_MINUTES=5
# Log ids of resolved mentions from Track Seen payloads (never content)
# SEEN_DEBUG_PAYLOADS=1
