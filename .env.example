# Required
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Storage — the directory MUST be on host storage encrypted at rest (see README)
DATABASE_PATH=./data/seen.db

# trace | debug | info | warn | error
LOG_LEVEL=info
NODE_ENV=development

# Dev-only (ignored when NODE_ENV=production): shorten policy windows for manual testing
# SEEN_WEAK_WINDOW_MINUTES=2
# SEEN_TRACKING_TTL_MINUTES=3
# SEEN_RETENTION_MINUTES=5
# Log ids of resolved mentions from Track Seen payloads (never content)
# SEEN_DEBUG_PAYLOADS=1
